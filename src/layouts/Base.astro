---
import "../styles/tokens.css";
import "../styles/components.css";
import Analytics from "@vercel/analytics/astro";
import { site, categorySlug, waOrder } from "../lib/shop.js";
import { localBusiness, website } from "../lib/schema.js";

const {
  title,
  description,
  canonicalPath = "/",
  jsonld = [],
  ogImage,
  ogType = "website",
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);

// og:image must be an absolute URL. Product pages pass a site-relative path
// like "/posters/tokyo-street.webp", which every crawler — WhatsApp included —
// silently drops, so shared links showed no preview at all. That matters here
// more than usual: WhatsApp is the entire order channel.
const ogImg = new URL(ogImage || "/og-cover.jpg", Astro.site).href;

const waHref = waOrder();

// Global structured data, present on every page.
const globalSchema = [localBusiness(), website(), ...jsonld];

const cats = site.categoryMeta ? Object.keys(site.categoryMeta) : [];
const gaId = site.ga4 || "";
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#012624" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.name} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
    <!-- Inter 400/500 only — the reference's medium-weight-only strategy. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag; // define:vars scopes this script, so expose gtag globally on purpose
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}
    {
      globalSchema.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

    <header class="nav" id="top">
      <div class="nav-inner">
        <a class="brand" href="/" aria-label={`${site.name} — home`}>Prints <span>UAE</span></a>
        <nav aria-label="Main">
          <ul class="nav-links" id="navLinks">
            <li><a href="/posters/">Posters</a></li>
            <li><a href="/metal-photo-prints/">Photo prints</a></li>
            <li><a href="/metal-signage/">Signage</a></li>
            <li><a href="/metal-awards/">Awards</a></li>
            <li><a href="/#faq">FAQ</a></li>
          </ul>
        </nav>
        <div class="nav-actions">
          <a class="btn btn-accent nav-cta-desktop" href={waHref} target="_blank" rel="noopener">Order on WhatsApp</a>
          <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">Prints <span>UAE</span></a>
          <p>{site.tagline}. Dye-sublimation metal printing, produced in Al&nbsp;Quoz, Dubai.</p>
        </div>
        <div class="footer-col">
          <h4>Shop posters</h4>
          <ul>
            {cats.map((c) => (
              <li><a href={`/${categorySlug(c)}/`}>{c} posters</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Services</h4>
          <ul>
            {site.services.map((s) => (
              <li><a href={`/${s.slug}/`}>{s.nav}</a></li>
            ))}
            <li><a href="/#faq">FAQ</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <address>
            <span>{site.address.street}, {site.address.city}</span>
            <a href={`tel:${site.phoneDisplay.replace(/\s/g, "")}`}>{site.phoneDisplay}</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </address>
        </div>
      </div>
      <div class="wrap footer-base">
        <span>© 2026 {site.name} — {site.address.city}, UAE</span>
        <span>Dye, fused into metal at 199°C</span>
      </div>
    </footer>

    <a class="wa-fab" href={waHref} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-2.1c1.8.9 3.7 1.4 5.8 1.4h.1c6.6 0 11.9-5.4 11.9-12S22.6 3 16 3zm0 21.8h-.1c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.3 1.1 1.1-4.2-.2-.4C6 19.6 5.5 17.8 5.5 15 5.5 9.2 10.2 4.5 16 4.5S26.5 9.2 26.5 15 21.8 24.8 16 24.8zm5.7-7.4c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.2-.6.1c-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1s0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5s0-.4 0-.5-.7-1.6-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/>
      </svg>
    </a>

    <Analytics />

    <script>
      import { track } from "@vercel/analytics";

      // track WhatsApp button clicks as a Vercel Analytics custom event.
      // Delegated, so it covers every wa.me link on the page (buttons + floating FAB).
      document.addEventListener("click", (e) => {
        const a = e.target.closest && e.target.closest('a[href*="wa.me"]');
        if (!a) return;
        const label = (a.getAttribute("aria-label") || a.textContent || "").trim().slice(0, 60);
        track("whatsapp_click", { page: location.pathname, label }); // Vercel (works on Pro)
        if (window.gtag) window.gtag("event", "whatsapp_click", { page: location.pathname, label }); // GA4
      });

      // sticky nav border on scroll
      const nav = document.querySelector(".nav");
      if (nav) {
        const f = () => nav.classList.toggle("scrolled", window.scrollY > 8);
        addEventListener("scroll", f, { passive: true });
        f();
      }
      // mobile menu
      const t = document.getElementById("navToggle");
      const l = document.getElementById("navLinks");
      if (t && l) {
        t.addEventListener("click", () => {
          const o = l.classList.toggle("open");
          t.setAttribute("aria-expanded", String(o));
        });
        l.addEventListener("click", (e) => {
          if (e.target.tagName === "A") {
            l.classList.remove("open");
            t.setAttribute("aria-expanded", "false");
          }
        });
      }
    </script>

    <!-- Specular highlight + tilt on the metal panels. Pointer-driven, so
         the surfaces behave like reflective metal instead of flat images.
         Pointer-devices only, rAF-throttled, and skipped under reduced-motion. -->
    <script is:inline>
      (function () {
        if (
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !matchMedia("(hover: hover) and (pointer: fine)").matches
        ) return;

        // opts: { tilt, baseRy, baseRx, swing } — panels with a resting tilt
        // are nudged around it rather than snapped to flat on first hover.
        function bind(el, opts) {
          opts = opts || {};
          var swing = opts.swing || 7;   // degrees; more stops reading as a lit panel
          var target = null;
          var queued = false;  // per-element: a shared flag makes handlers eat each other's frames

          el.addEventListener("pointermove", function (e) {
            var r = el.getBoundingClientRect();
            target = {
              mx: ((e.clientX - r.left) / r.width) * 100,
              my: ((e.clientY - r.top) / r.height) * 100,
            };
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () {
              queued = false;
              if (!target) return;
              el.style.setProperty("--mx", target.mx.toFixed(1) + "%");
              el.style.setProperty("--my", target.my.toFixed(1) + "%");
              if (opts.tilt) {
                var ry = (opts.baseRy || 0) + ((target.mx - 50) / 50) * swing;
                var rx = (opts.baseRx || 0) + ((50 - target.my) / 50) * swing * 0.6;
                el.style.setProperty("--ry", ry.toFixed(2) + "deg");
                el.style.setProperty("--rx", rx.toFixed(2) + "deg");
              }
            });
          });

          el.addEventListener("pointerleave", function () {
            target = null;
            el.style.removeProperty("--mx");
            el.style.removeProperty("--my");
            el.style.removeProperty("--rx");
            el.style.removeProperty("--ry");
          });
        }

        document.querySelectorAll(".poster-card").forEach(function (c) {
          bind(c.querySelector(".poster-thumb") || c);   // specular only
          bind(c, { tilt: true });
        });

        // Panels with a resting angle in CSS — keep that angle as the centre.
        var hero = document.getElementById("heroPanel");
        if (hero) bind(hero, { tilt: true, baseRy: -13, baseRx: 3, swing: 6 });

        var product = document.getElementById("productPanel");
        if (product) bind(product, { tilt: true, baseRy: -6, baseRx: 1.5, swing: 5 });
      })();
    </script>

    <!-- Scroll-reveal lives in its own dependency-free inline script on
         purpose: [data-reveal] starts at opacity 0, so if it shared a module
         with the analytics import, a failed import would blank the page. -->
    <script is:inline>
      (function () {
        var reveals = document.querySelectorAll("[data-reveal]");
        var show = function () {
          for (var i = 0; i < reveals.length; i++) reveals[i].classList.add("in");
        };
        if (
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          show();
          return;
        }
        var io = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add("in");
                obs.unobserve(en.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        for (var i = 0; i < reveals.length; i++) io.observe(reveals[i]);
        // Safety net: nothing stays invisible if the observer never fires.
        setTimeout(show, 2500);
      })();
    </script>
  </body>
</html>
