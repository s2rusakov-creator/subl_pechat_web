---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PosterCard from "../../components/PosterCard.astro";
import Icon from "../../components/Icon.astro";
import { shop, site, posterSlug, categorySlug, waLink, fromPriceOf } from "../../lib/shop.js";
import { productSchema, breadcrumb } from "../../lib/schema.js";

export function getStaticPaths() {
  return shop.posters.map((poster) => ({
    params: { slug: posterSlug(poster) },
    props: { poster },
  }));
}

const { poster } = Astro.props;
const from = fromPriceOf(poster);
const path = `/posters/${posterSlug(poster)}/`;
const catPath = `/${categorySlug(poster.category)}/`;

const title = `${poster.title} — Metal Poster Printed in Dubai | Prints UAE`;
const description = `${poster.desc} From AED ${from}, delivered across the UAE in 2–3 days.`;

// The size line is left blank in the server-rendered link on purpose. The
// script fills it from the checked radio; without JS the radios cannot drive
// the link, and a hard-coded size would then contradict what the visitor
// picked. A blank line is honest either way.
const orderIntro = `Hi Prints UAE! I'd like to order the "${poster.title}" metal poster.`;
const orderHref = waLink(site.whatsapp, `${orderIntro}\nSize: \nName: `);

const related = shop.posters
  .filter((p) => p.category === poster.category && p.title !== poster.title)
  .slice(0, 4);

const jsonld = [
  productSchema(poster, path, from),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: `${poster.category} posters`, path: catPath },
    { name: poster.title, path },
  ]),
];
---
<Base title={title} description={description} canonicalPath={path} jsonld={jsonld} ogImage={poster.img} ogType="product">
  <article class="product">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { name: "Home", path: "/" },
          { name: `${poster.category} posters`, path: catPath },
          { name: poster.title },
        ]}
      />

      <div class="product-grid">
        <div class="product-media" data-reveal>
          <div class="product-stage">
            <div class="poster-thumb product-thumb" id="productPanel">
              <img src={poster.img} alt={poster.alt} width="960" height="1280" fetchpriority="high" />
            </div>
          </div>
          <p class="product-media-note">
            Shown as a gloss panel. Matte and brushed-silver finishes are available on request.
          </p>
        </div>

        <div class="product-info" data-reveal>
          <a class="product-cat" href={catPath}>{poster.category} · Metal poster</a>
          <h1>{poster.title}</h1>
          <p class="product-price">
            <span class="product-price-prefix" id="pricePrefix">from </span>AED&nbsp;<span id="priceValue">{from}</span>
          </p>
          <p class="product-desc">{poster.desc}</p>

          <ul class="product-points">
            <li><Icon name="layers" size={20} />Infused into the metal — colours never peel or fade</li>
            <li><Icon name="droplet" size={20} />Waterproof &amp; scratch-proof</li>
            <li><Icon name="hook" size={20} />Lightweight, mount included</li>
            <li><Icon name="truck" size={20} />Printed in Dubai, delivered in 2–3 days</li>
          </ul>

          <fieldset class="product-sizes" id="sizePicker">
            <legend class="product-sizes-label">Choose a size</legend>
            <div class="product-size-row">
              {shop.sizes.map((s, i) => (
                <label class="size-pill">
                  <input
                    type="radio"
                    name="poster-size"
                    value={s.name}
                    data-dim={s.dim}
                    data-price={s.price}
                    checked={i === 0}
                  />
                  <span class="size-pill-name">{s.name}</span>
                  <span class="size-pill-dim">{s.dim}</span>
                  <span class="size-pill-price">AED {s.price}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <a
            class="btn btn-accent product-order"
            id="orderLink"
            href={orderHref}
            data-wa={site.whatsapp}
            data-intro={orderIntro}
            target="_blank"
            rel="noopener"
          >Order on WhatsApp</a>
          <p class="product-note">
            The message opens with your design and size already written in — just send it.
            We confirm the price within a few minutes during studio hours
            ({site.openingHours.replace("Sa-Th", "Sat–Thu ")}).
          </p>

          <ul class="product-assurance">
            <li><Icon name="check" size={16} />Mount included — no framing needed</li>
            <li><Icon name="check" size={16} />Printed in Al Quoz, delivered in 2–3 days</li>
            <li><Icon name="check" size={16} />Free delivery over AED 300</li>
          </ul>

          <!-- The highest-value order is someone's own image, and until now
               there was no route to it from a product page. -->
          <a class="product-own go" href="/metal-photo-prints/">
            Rather print your own photo on metal?
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </div>

      <script is:inline>
        // Size picker: keeps the headline price and the WhatsApp message in
        // sync with the chosen size, so the enquiry that arrives is complete
        // instead of "Size: ____". Without this script the radios simply do
        // nothing and the link keeps its blank size line.
        (function () {
          var picker = document.getElementById("sizePicker");
          var link = document.getElementById("orderLink");
          var priceValue = document.getElementById("priceValue");
          var pricePrefix = document.getElementById("pricePrefix");
          if (!picker || !link) return;

          var wa = String(link.dataset.wa || "").replace(/[^0-9]/g, "");
          var intro = link.dataset.intro || "";

          function sync() {
            var input = picker.querySelector("input:checked");
            if (!input) return;

            var name = input.value;
            var dim = input.dataset.dim;
            var price = input.dataset.price;

            if (priceValue) priceValue.textContent = price;
            if (pricePrefix) pricePrefix.textContent = "";   // no longer "from"

            var msg = intro + "\nSize: " + name + " (" + dim + ") — AED " + price + "\nName: ";
            link.href = "https://wa.me/" + wa + "?text=" + encodeURIComponent(msg);
          }

          picker.addEventListener("change", sync);
          sync();   // the first size is pre-checked, so start in sync
        })();
      </script>

      {related.length > 0 && (
        <section class="related">
          <h2><a href={catPath}>More {poster.category.toLowerCase()} posters</a></h2>
          <div class="posters">
            {related.map((p, i) => <PosterCard poster={p} index={i} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</Base>
