---
import Base from "../layouts/Base.astro";
import PosterCard from "../components/PosterCard.astro";
import Icon from "../components/Icon.astro";
import SizeScale from "../components/SizeScale.astro";
import { shop, site, categorySlug, waOrder } from "../lib/shop.js";
import { faqPage } from "../lib/schema.js";

const title = "Metal Posters Printed in Dubai | Prints UAE";
const description =
  "Cool posters printed on metal in Dubai — vivid, waterproof and built to last. Browse space, nature, car and city designs from AED 120, delivered across the UAE in 2–3 days.";

const jsonld = [faqPage(site.faqs)];

// Hero slider: a few striking designs. Falls back to the first 4 posters.
const featuredTitles = ["Dubai Marina, Night", "Carina Nebula", "Desert Gold", "Island Escape"];
const featured = featuredTitles
  .map((t) => shop.posters.find((p) => p.title === t))
  .filter(Boolean);
const slides = featured.length ? featured : shop.posters.slice(0, 4);

// One representative image per category for the "shop by collection" strip.
const collections = shop.categories.map((c) => ({
  name: c,
  slug: categorySlug(c),
  img: shop.posters.find((p) => p.category === c)?.img,
  count: shop.posters.filter((p) => p.category === c).length,
}));

// Process steps. Each carries one concrete, checkable fact — the specifics
// (199°C, ChromaLuxe, ΔE) are what separate this from generic print copy.
const steps = [
  {
    n: "1",
    t: "Pick a design",
    d: `Browse ${shop.posters.length} designs in the catalogue, or send your own photo — we check the resolution before anything is printed.`,
    badge: `${shop.posters.length} designs`,
    sub: "or bring your own file",
  },
  {
    n: "2",
    t: "Tell us the size",
    d: `${["One","Two","Three","Four","Five","Six"][shop.sizes.length - 1] || shop.sizes.length} standard sizes from ${shop.sizes[0].dim} to ${shop.sizes[shop.sizes.length - 1].dim}, plus custom. We confirm the exact price on WhatsApp in a few minutes.`,
    badge: `${shop.sizes[0].dim.replace(/\s*cm$/, "")} → ${shop.sizes[shop.sizes.length - 1].dim.replace(/\s*cm$/, "")}`,
    sub: "custom sizes on request",
  },
  {
    n: "3",
    t: "We fuse it into metal",
    d: "In our Al Quoz studio the dye turns to gas at 199°C and bonds inside the panel coating. The image is now part of the metal — there is no ink layer left on top to scratch off.",
    badge: "199°C",
    sub: "dye-sublimation, not ink on top",
  },
  {
    n: "4",
    t: "On your wall in 2–3 days",
    d: "Delivered across all seven emirates with the mount already included. No framing, no glass, no extra trip to a framer.",
    badge: "2–3 days",
    sub: "mount included, ready to hang",
  },
];

// One panel image per step, reused from the catalogue.
const stepImgs = slides.slice(0, 4).map((p) => p.img);
---

<Base title={title} description={description} canonicalPath="/" jsonld={jsonld}>
  <!-- HERO -->
  <section class="hero-slider" id="home" aria-label="Featured metal posters">
    <div class="slides" aria-hidden="true">
      {slides.map((p, i) => (
        <div class:list={["slide", { active: i === 0 }]} style={`background-image:url(${p.img})`}></div>
      ))}
    </div>
    <div class="hero-scrim"></div>
    <div class="glow hero-glow-a" aria-hidden="true"></div>
    <div class="glow hero-glow-b" aria-hidden="true"></div>
    <div class="hero-sheen" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Prints UAE — Al Quoz, Dubai</span>
        <h1>Posters, fused into <em class="chrome">metal</em></h1>
        <p>Vivid, waterproof and seriously tough. Pick a design, pick a size — we print it here in Dubai and deliver in 2–3 days.</p>
        <div class="hero-cta">
          <a class="btn btn-accent" href="#posters">Browse posters</a>
          <a class="btn btn-glass" href="#sizes">Sizes &amp; prices</a>
        </div>
        <div class="hero-dots">
          {slides.map((_, i) => (
            <button class:list={["dot", { active: i === 0 }]} data-i={i} aria-label={`Show slide ${i + 1}`}></button>
          ))}
        </div>
      </div>

      <div class="hero-stage">
        <div class="hero-panel" id="heroPanel">
          <div class="hero-panel-stack">
            {slides.map((p, i) => (
              <img
                class:list={[{ active: i === 0 }]}
                src={p.img}
                alt={i === 0 ? p.alt : ""}
                width="800"
                height="1066"
                fetchpriority={i === 0 ? "high" : undefined}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            ))}
          </div>
          <div class="hero-panel-edge" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <button class="hero-arrow prev" aria-label="Previous poster">‹</button>
    <button class="hero-arrow next" aria-label="Next poster">›</button>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-row">
      <span>Dye-sublimated at <b>199°C</b></span><span>·</span>
      <span>Scratch-proof &amp; waterproof</span><span>·</span>
      <span>UAE-wide in <b>2–3 days</b></span><span>·</span>
      <span>Printed in Al Quoz, Dubai</span><span>·</span>
      <span>Mount included</span><span>·</span>
      <span>From <b>AED 120</b></span><span>·</span>
    </div>
    <div class="ticker-row">
      <span>Dye-sublimated at <b>199°C</b></span><span>·</span>
      <span>Scratch-proof &amp; waterproof</span><span>·</span>
      <span>UAE-wide in <b>2–3 days</b></span><span>·</span>
      <span>Printed in Al Quoz, Dubai</span><span>·</span>
      <span>Mount included</span><span>·</span>
      <span>From <b>AED 120</b></span><span>·</span>
    </div>
  </div>

  <!-- WHY METAL -->
  <section class="section why" id="why">
    <div class="wrap why-grid">
      <div class="why-head" data-reveal>
        <span class="eyebrow">Why metal</span>
        <h2>Three things paper can't do</h2>
        <p>
          A metal print is not a poster with a fancier backing. It is a different object,
          and the difference is worth understanding before you spend anything.
        </p>
        <a class="go" href="#compare">
          Compare it against canvas and framed prints
          <Icon name="arrow" size={14} />
        </a>
      </div>

      <ul class="why-list">
        <li data-reveal style="--d:0ms">
          <span class="info-icon"><Icon name="layers" size={24} /></span>
          <div>
            <h3>There is no ink on top</h3>
            <p>At 199°C the dye turns to gas and bonds <em>inside</em> the panel's coating. Nothing sits on the surface, which is why nothing can peel, crack or scratch off it.</p>
          </div>
        </li>
        <li data-reveal style="--d:80ms">
          <span class="info-icon"><Icon name="sun" size={24} /></span>
          <div>
            <h3>No glass, no glare</h3>
            <p>Framed prints mirror your ceiling lights back at you. A metal panel has nothing in front of the image — and no glass to fog, break or ship carefully.</p>
          </div>
        </li>
        <li data-reveal style="--d:160ms">
          <span class="info-icon"><Icon name="droplet" size={24} /></span>
          <div>
            <h3>Made for UAE humidity</h3>
            <p>Waterproof and humidity-resistant, so kitchens, bathrooms and shaded balconies are all fine. Wipe it down with a damp cloth when it gets dusty.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- SHOP BY COLLECTION -->
  <section class="section collections">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Collections</span>
          <h2>Shop by collection</h2>
        </div>
        <p>Curated metal poster collections — tap through to the full set.</p>
      </div>
      <div class="collection-grid">
        {collections.map((c, i) => (
          <a class="collection-card" href={`/${c.slug}/`} data-reveal style={`--d:${i * 60}ms`}>
            <div class="collection-thumb" style={`background-image:url(${c.img})`}></div>
            <div class="collection-meta">
              <span>
                <span class="collection-name">{c.name}</span>
                <span class="collection-count">{c.count} designs</span>
              </span>
              <span class="arrow-btn"><Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POSTERS -->
  <section class="section lit-section" id="posters">
    <div class="glow glow-top-right" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Catalogue</span>
          <h2>Browse posters</h2>
        </div>
        <p>Tap a design to see sizes and order on WhatsApp.</p>
      </div>

      <div class="chips" id="chips" role="tablist" aria-label="Filter posters">
        <button class="chip active" data-filter="all">All</button>
        {shop.categories.map((c) => (
          <button class="chip" data-filter={c.toLowerCase()}>{c}</button>
        ))}
      </div>

      <div class="posters" id="posters-grid">
        {shop.posters.map((p, i) => <PosterCard poster={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services-band" id="services">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Divisions</span>
          <h2>More than posters</h2>
        </div>
        <p>Everything we print is dye-sublimated into metal, right here in Dubai.</p>
      </div>
      <div class="services-grid">
        {site.services.map((s, i) => (
          <a class="service-card" href={`/${s.slug}/`} data-reveal style={`--d:${i * 70}ms`}>
            <div class="service-card-img" style={`background-image:url(${s.img})`}></div>
            <div class="service-card-body">
              <div class="service-card-head">
                <h3>{s.nav}</h3>
                <span class="arrow-btn"><Icon name="arrow" size={16} /></span>
              </div>
              <p>{s.lede}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how" id="how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Process</span>
          <h2>How it works</h2>
        </div>
        <p>From a design you like to metal on your wall — in four steps.</p>
      </div>
      <div class="how-scroller">
        <div class="how-visual">
          <div class="how-panel">
            <div class="how-panel-stack">
              {stepImgs.map((img, i) => (
                <img
                  class:list={["how-img", { active: i === 0 }]}
                  src={img}
                  alt=""
                  width="800"
                  height="1066"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="how-heat" aria-hidden="true"></div>
            <div class="how-readout" aria-hidden="true">
              {steps.map((s, i) => (
                <div class:list={["how-readout-item", { active: i === 0 }]}>
                  <strong>{s.badge}</strong>
                  <span>{s.sub}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <ol class="steps">
          {steps.map((s, i) => (
            <li class:list={["step", { active: i === 0 }]} data-n={s.n}>
              <span class="step-n">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section compare" id="compare">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Straight answer</span>
          <h2>Metal, canvas or a framed print?</h2>
        </div>
        <p>Metal is not the right answer for every wall. Here is where it wins and where it doesn't.</p>
      </div>

      <div class="compare-scroll" data-reveal>
        <table class="compare-table">
          <caption class="sr-only">
            Comparison of metal panels, framed paper prints and canvas across durability, glare, detail and cost
          </caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Criterion</span></th>
              <th scope="col" class="is-ours">Metal panel<span>what we make</span></th>
              <th scope="col">Framed paper<span>print + glass</span></th>
              <th scope="col">Canvas<span>stretched fabric</span></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Colour over time</th>
              <td class="is-ours">Dye sits inside the coating. ChromaLuxe panels are rated past 65 years on display.</td>
              <td>Ink on paper. Noticeably fades in direct sun within a few years.</td>
              <td>Ink on fabric. Fades, and the fabric can yellow.</td>
            </tr>
            <tr>
              <th scope="row">Kitchens &amp; bathrooms</th>
              <td class="is-ours">Waterproof. Wipe it with a damp cloth.</td>
              <td>Paper cockles, glass fogs in steam.</td>
              <td>Fabric holds moisture — not advised.</td>
            </tr>
            <tr>
              <th scope="row">Reflections</th>
              <td class="is-ours">No glass in front of the image. Gloss panels still catch a direct spotlight — ask for matte if the wall faces one.</td>
              <td>Glass mirrors your ceiling lights and windows.</td>
              <td class="is-win">Matte weave, effectively no glare. Canvas wins here.</td>
            </tr>
            <tr>
              <th scope="row">Fine detail</th>
              <td class="is-ours">Continuous tone, no paper grain or weave.</td>
              <td>Sharp — good paper resolves detail well.</td>
              <td>The weave softens small text and fine texture.</td>
            </tr>
            <tr>
              <th scope="row">If it gets knocked</th>
              <td class="is-ours">Scratch-resistant, nothing to shatter.</td>
              <td>Glass breaks, and it is the expensive part.</td>
              <td>Punctures, and sags over time.</td>
            </tr>
            <tr>
              <th scope="row">What else you pay for</th>
              <td class="is-ours">Nothing. The mount is included.</td>
              <td>Frame, glass, mount board, framer's labour.</td>
              <td>Stretcher bars, sometimes a floater frame.</td>
            </tr>
            <tr>
              <th scope="row">Cost up front</th>
              <td class="is-ours">From AED 120, finished and ready to hang.</td>
              <td class="is-win">Cheapest way to get an image on a wall. Paper wins here.</td>
              <td>Usually lands between the two.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="compare-note" data-reveal>
        If the piece is going somewhere dry and shaded, you are on a tight budget, and you already own a frame —
        a paper print is genuinely the sensible buy. Metal earns its price in bright rooms, humid rooms, and
        anywhere the picture needs to still look right in ten years.
      </p>
    </div>
  </section>

  <!-- SIZES -->
  <section class="sizes-band" id="sizes">
    <div class="wrap section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Format</span>
          <h2>Sizes &amp; prices</h2>
        </div>
        <p>Any design, any size below.</p>
      </div>
      <div class="sizes-grid">
        {shop.sizes.map((s, i) => (
          <div class="size-card" data-reveal style={`--d:${i * 50}ms`}>
            <div class="size-name">{s.name}</div>
            <div class="size-dim">{s.dim}</div>
            <div class="size-price">AED {s.price}</div>
          </div>
        ))}
        <div class="size-card size-custom" data-reveal style="--d:200ms">
          <div class="size-name">Custom</div>
          <div class="size-dim">Any size you want</div>
          <a class="btn btn-plain" href={waOrder("Hi Prints UAE! I'd like a custom-size metal poster.")} target="_blank" rel="noopener">Ask us</a>
        </div>
      </div>
      <p class="size-note">Indicative prices — the final quote depends on finish. Message us and we'll confirm in a few minutes.</p>

      <div data-reveal><SizeScale /></div>

      <!-- What the price covers. Placed here on purpose: hidden extras are
           the last thing that stops someone at the price, so answer it in
           the same breath as the number. -->
      <div class="included" id="delivery" data-reveal>
        <div class="included-copy">
          <span class="eyebrow">In the price</span>
          <div class="big">No frame, no glass, no framer.</div>
          <p>
            The panel arrives finished. That is the whole reason a metal print costs what it does up front
            and less by the time it is on the wall.
          </p>
        </div>
        <ul class="included-list">
          <li><Icon name="check" size={18} />Wall mount fitted to the back</li>
          <li><Icon name="check" size={18} />Colour-managed proof before we print</li>
          <li><Icon name="check" size={18} />Protective packaging, UAE-wide courier</li>
          <li><Icon name="check" size={18} />Free delivery over AED 300</li>
        </ul>
        <div class="included-stats">
          <div class="stat"><strong>2–3</strong><span>Days, UAE-wide</span></div>
          <div class="stat"><strong>7</strong><span>Emirates covered</span></div>
          <div class="stat"><strong>Next-day</strong><span>Dubai express</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="wrap faq-wrap">
      <div class="faq-head">
        <h2>Frequently asked questions</h2>
        <p>Everything about metal posters, prints and delivery in the UAE.</p>
      </div>
      <div class="faq-list">
        {site.faqs.map((f) => (
          <details class="faq-item" data-reveal>
            <summary>{f.q}<span class="faq-icon" aria-hidden="true"></span></summary>
            <div class="faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact lit-section" id="contact">
    <div class="glow glow-bottom-left" aria-hidden="true"></div>
    <div class="glow glow-top-right" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow">Get started</span>
      <h2>Ready to order <span class="chrome">in metal?</span></h2>
      <p>Send us the design you want and the size — we'll sort the rest.</p>
      <div class="hero-cta">
        <a class="btn btn-accent" href={waOrder()} target="_blank" rel="noopener">Message on WhatsApp</a>
        <a class="btn btn-plain" href={`mailto:${site.email}`}>Email us</a>
      </div>
    </div>
  </section>

  <!-- GSAP is ~110 KB, and everything it drives is desktop-only, so it is
       loaded dynamically behind the same gates the module itself checks.
       Phones and reduced-motion users download none of it. Kept in its own
       module so a failure here cannot take the reveal or slider scripts down. -->
  <script>
    const wanted =
      !matchMedia("(prefers-reduced-motion: reduce)").matches &&
      matchMedia("(min-width: 940px)").matches;

    if (wanted) {
      const start = () => import("../scripts/motion.js");
      // Let the hero paint first — this is enhancement, not content.
      if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 2000 });
      else setTimeout(start, 500);
    }
  </script>

  <script>
    // hero slider — drives the blurred backdrop, the dots and the panel
    const slider = document.querySelector(".hero-slider");
    if (slider) {
      const slides = [...slider.querySelectorAll(".slide")];
      const dots = [...slider.querySelectorAll(".dot")];
      const panels = [...slider.querySelectorAll(".hero-panel-stack img")];
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let i = 0, timer;
      const go = (n) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, x) => s.classList.toggle("active", x === i));
        dots.forEach((d, x) => d.classList.toggle("active", x === i));
        panels.forEach((p, x) => p.classList.toggle("active", x === i));
      };
      const start = () => { if (!reduce && slides.length > 1) timer = setInterval(() => go(i + 1), 5000); };
      const reset = () => { clearInterval(timer); start(); };
      dots.forEach((d) => d.addEventListener("click", () => { go(Number(d.dataset.i)); reset(); }));
      slider.querySelector(".prev")?.addEventListener("click", () => { go(i - 1); reset(); });
      slider.querySelector(".next")?.addEventListener("click", () => { go(i + 1); reset(); });
      slider.addEventListener("mouseenter", () => clearInterval(timer));
      slider.addEventListener("mouseleave", start);
      start();
    }

    // FAQ accordion — <details> has no native open/close animation, so the
    // panel height is driven here. If this script never runs, the accordion
    // still opens and closes natively, just without the slide.
    const faqReduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll(".faq-item").forEach((item) => {
      const summary = item.querySelector("summary");
      const panel = item.querySelector(".faq-a");
      if (!summary || !panel) return;
      let busy = false;

      const settle = (done) => {
        let finished = false;
        const finish = () => {
          if (finished) return;
          finished = true;
          panel.removeEventListener("transitionend", end);
          clearTimeout(timer);
          done();
        };
        const end = (e) => {
          if (e.target === panel && e.propertyName === "height") finish();
        };
        panel.addEventListener("transitionend", end);
        // transitionend never fires if the transition does not actually run —
        // a backgrounded tab, a hidden element, an interrupted animation.
        // Without this fallback the item would latch and never reopen.
        const timer = setTimeout(finish, 600);
      };

      summary.addEventListener("click", (e) => {
        if (faqReduce) return;          // let the browser just toggle it
        e.preventDefault();
        if (busy) return;
        busy = true;

        if (item.open) {
          panel.style.height = panel.scrollHeight + "px";
          requestAnimationFrame(() => { panel.style.height = "0px"; });
          settle(() => {
            item.open = false;
            panel.style.height = "";
            busy = false;
          });
        } else {
          item.open = true;             // content must exist before measuring
          const target = panel.scrollHeight;
          panel.style.height = "0px";
          requestAnimationFrame(() => { panel.style.height = target + "px"; });
          settle(() => {
            panel.style.height = "";    // back to auto, so reflow stays correct
            busy = false;
          });
        }
      });
    });

    // poster filter
    const chips = document.querySelectorAll(".chip");
    const cards = document.querySelectorAll("#posters-grid .poster-card");
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const f = chip.getAttribute("data-filter");
        chips.forEach((c) => c.classList.toggle("active", c === chip));
        cards.forEach((card) => {
          card.style.display = f === "all" || card.getAttribute("data-cat") === f ? "" : "none";
        });
      });
    });
  </script>
</Base>
