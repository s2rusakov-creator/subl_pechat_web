---
// Thin geometric line icons (Lucide-derived, 1.5px stroke, currentColor).
// Replaces the emoji that used to stand in for icons.
const { name, size = 24, class: cls = "" } = Astro.props;

const paths = {
  // dye fused into the panel — stacked layers
  layers: [
    "M12 2 2 7l10 5 10-5-10-5Z",
    "m2 12 10 5 10-5",
    "m2 17 10 5 10-5",
  ],
  // waterproof — droplet
  droplet: ["M12 22a7 7 0 0 0 7-7c0-5-7-13-7-13S5 10 5 15a7 7 0 0 0 7 7Z"],
  // easy to hang — hook
  hook: ["M12 21V8", "M12 8a4 4 0 1 1 4-4"],
  // delivery — truck
  truck: [
    "M14 17V5a1 1 0 0 0-1-1H2v12h12Z",
    "M14 9h4l4 4v4h-8",
    "M6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
    "M18.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
  ],
  // go-to trigger — diagonal arrow
  arrow: ["M7 17 17 7", "M8 7h9v9"],
  // no glass, no glare — sun with rays
  sun: [
    "M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z",
    "M12 2v2", "M12 20v2", "M4.9 4.9l1.4 1.4", "M17.7 17.7l1.4 1.4",
    "M2 12h2", "M20 12h2", "M6.3 17.7l-1.4 1.4", "M19.1 4.9l-1.4 1.4",
  ],
  // comparison winner — check
  check: ["M20 6 9 17l-5-5"],
  // comparison loser — minus
  minus: ["M5 12h14"],
};

const d = paths[name] || [];
---
<svg
  class={`ico ${cls}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {d.map((p) => <path d={p} />)}
</svg>
